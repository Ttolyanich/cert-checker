# ==============================================================================
# Шаблон конфигурации окружения для Cert-Checker (бэкенд)
# Переименуйте этот файл в .env и настройте параметры ниже
# ==============================================================================

# Секретный ключ для подписи сессий и токенов (обязательно смените в продакшне)
# Для генерации случайного ключа выполните команду:
# openssl rand -hex 32
SECRET_KEY=prod_super_secret_key_change_me_in_env_file

# Секретный токен для интеграции с Zabbix LLD API
ZABBIX_TOKEN=zabbix_secret_token

# URL подключения к базе данных (по умолчанию SQLite)
# Пример для PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:////data/cert_checker.db

# Первоначальные учетные данные администратора (создаются при чистом запуске)
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin123

# Настройки отправки почтовых оповещений (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Использовать STARTTLS (True) или прямой SSL (False)
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@certchecker.local
EMAILS_FROM_NAME=Cert-Checker Alert
