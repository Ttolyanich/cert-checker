# ==============================================================================
# Конфигурация Cert-Checker (All-in-One)
# Скопируйте этот файл в .env:
#   cp .env.example .env
# Все настройки задаются исключительно здесь без необходимости менять docker-compose.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Сетевые настройки и Docker
# ------------------------------------------------------------------------------
# IP-адрес для привязки веб-сервера (0.0.0.0 — слушать на всех интерфейсах, 127.0.0.1 — только локально)
BIND_HOST=0.0.0.0

# Внешний порт панели управления (по умолчанию 8080)
PORT=8080

# Путь на хосте для сохранения постоянных данных и SQLite базы данных
DATA_PATH=./data

# ------------------------------------------------------------------------------
# 🔐 Безопасность и База Данных
# ------------------------------------------------------------------------------
# Секретный ключ для подписи токенов JWT (обязательно смените в продакшне!)
# Сгенерировать ключ: openssl rand -hex 32
SECRET_KEY=prod_super_secret_key_change_me_in_env_file

# Секретный токен для интеграции с Zabbix LLD API (/api/v1/zabbix/discovery, /api/v1/zabbix/metrics)
ZABBIX_TOKEN=zabbix_secret_token

# URL подключения к базе данных (внутри контейнера база лежит в /data)
DATABASE_URL=sqlite:////data/cert_checker.db

# ------------------------------------------------------------------------------
# 👤 Локальный администратор по умолчанию
# ------------------------------------------------------------------------------
# Создается автоматически при первом чистом запуске (доступен всегда)
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 🏢 Доменная авторизация Active Directory (LDAP)
# ------------------------------------------------------------------------------
# Включить авторизацию через контроллер домена Active Directory (true / false)
LDAP_ENABLED=false

# Адрес контроллера домена (например: ldap://10.11.4.254:389 или ldaps://dc1.corp.local:636)
LDAP_SERVER=ldap://10.11.4.254:389

# Имя корпоративного домена (например: corp.local)
LDAP_DOMAIN=corp.local

# Базовый DN каталога для поиска пользователей и групп
LDAP_BASE_DN=DC=corp,DC=local

# Ограничение по группе безопасности: доступ разрешен только членам этой группы (опционально)
LDAP_REQUIRED_GROUP=Domain Users

# Группа безопасности AD для назначения роли администратора (опционально)
LDAP_ADMIN_GROUP=Domain Admins

# Список конкретных доменных логинов/почт администраторов через запятую (опционально)
LDAP_ADMIN_USERS=admin,sysadmin@corp.local

# Сервисная учетная запись для поиска пользователей и проверки вложенных групп (рекомендуется)
LDAP_BIND_USER=CN=svc_ldap,OU=Service,DC=corp,DC=local
LDAP_BIND_PASSWORD=YourStrongServicePassword

# Поддержка рекурсивного поиска во вложенных группах AD (1.2.840.113556.1.4.1941)
LDAP_NESTED_GROUPS=true

# ------------------------------------------------------------------------------
# ✉️ Настройки отправки почтовых оповещений (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Использовать STARTTLS (True) или прямой SSL (False)
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@certchecker.local
EMAILS_FROM_NAME=Cert-Checker Alert
